[Unit]
Description=asmltr-insights-collector (127.0.0.1:3017)
After=network-online.target
# Optional. Needed for the insights TUI / dashboard, not for asmltr ask.

[Service]
Type=simple
WorkingDirectory=%h/asmltr/insights/collector
EnvironmentFile=-%h/asmltr/.env
Environment=HOME=%h
ExecStart=node server.js
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
