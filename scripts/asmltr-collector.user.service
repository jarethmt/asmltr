[Unit]
Description=asmltr-insights-collector (127.0.0.1:3017)
After=network-online.target
# Optional. Needed for the insights TUI / dashboard, not for asmltr ask.
# Template — %h is the installing user's home. Edit paths if the clone is not ~/src/asmltr.

[Service]
Type=simple
WorkingDirectory=%h/src/asmltr/insights/collector
EnvironmentFile=-%h/src/asmltr/.env
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/node server.js
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
