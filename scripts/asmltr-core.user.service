[Unit]
Description=asmltr-core (127.0.0.1)
After=network-online.target
# User-level template. Copy to ~/.config/systemd/user/ and enable linger for this user.
# %h is the installing user's home. Edit WorkingDirectory / ExecStart if the clone is not ~/src/asmltr.

[Service]
Type=simple
WorkingDirectory=%h/src/asmltr/core
EnvironmentFile=-%h/src/asmltr/.env
Environment=HOME=%h
Environment=PATH=%h/.local/bin:%h/.grok/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/node src/server.js
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
