# ivy localhost template — copy to .env in this clone (gitignored).
# No secrets. No Discord/Telegram/GitHub tokens. Subscription grok via ~/.grok/auth.json.
# Do not put a real email, snowflake, or host home path in this file.

ASSISTANT_NAME=ivy

# Bind is hardcoded 127.0.0.1 in core/src/server.js
ASMLTR_CORE_PORT=3023
ASMLTR_MANAGER_PORT=3024
ASMLTR_INSIGHTS_PORT=3017
ASMLTR_CORE_URL=http://127.0.0.1:3023/v2/handle
ASMLTR_COLLECTOR_URL=http://127.0.0.1:3017/ingest

# Web operator. Core stamps this onto assistant-web sender.raw_id.
# Must match the seeded identifier { surface: "assistant-web", value: "owner" }.
ASMLTR_WEB_OWNER_ID=owner

# TUI/engine-session tracker identity (not a trust channel). Default: OS username.
# ASMLTR_CLI_IDENTITY=

# Live card nap (display-only, collector + dashboard). 1800000 = 30 minutes.
# Do not set 0 — Live cards would never drop. This env is NOT session idle.
ASMLTR_IDLE_MS=1800000
# Grok/session idle is ASMLTR_IDLE_POLICY only. Unset or infinite/off/none
# keeps the grok resume UUID. idle:N is a finite session window.
ASMLTR_IDLE_POLICY=infinite

# ASMLTR_TRUST_SEED=/path/to/asmltr/core/src/trust/seed.json
# ASMLTR_GROK_BIN=~/.grok/bin/grok
# ASMLTR_NODE=/usr/local/bin/node
# Grok adapter: no spawn watchdog, no CLI turn cap. These env vars do not kill a child.
# ASMLTR_GROK_TIMEOUT_MS=
# ASMLTR_GROK_MAX_TURNS=
# ASMLTR_CORE_CONCURRENCY stays at the jarethmt default (6). Do not add a Grok-only cap.

# Optional. Owner-from address is not a kill path (no watchdog). Do not commit a real address.
# ASMLTR_OWNER_FROM_EMAIL=

# Baseline grok reasoning effort (always passed as --effort). This install uses medium so Discord chat is faster.
# Valid: low | medium | high | xhigh. Unset still defaults high. Web channels
# (assistant-web, assistant-native, eve-assistant-web, eve-assistant-native) are always high
# after one-shot/explicit — no word picker, no +h/+xh. Discord keeps the three-tier picker
# (lookup/research/Corona/Rolodex/troubleshooting → high; git/code/deep-dive → xhigh).
# Picture-intent is NOT the word picker: a kind-word (picture/image/photo/…) or an attached still
# runs a silent gpt-5-nano YES/NO on the moderation OpenAI key, then Discord/telegram raise to xhigh.
# Email and MCP are always xhigh (no classify). Missing openai_api_key: classify logs once and stays
# OFF; image_gen tools still work. Set ASMLTR_IMAGE_GEN_CLASSIFY=off to skip classify.
# HOME cwd is never a project.
# Score the current user message only (effortPrompt). One-shot: ~/.asmltr/next-effort (one line).
# No last-effort inherit. No XHIGH_CHANNELS. Cannot change mid-turn.
ASMLTR_GROK_EFFORT=medium
# ASMLTR_IMAGE_GEN_CLASSIFY=off
# ASMLTR_TOOL_POLICY_FILE=~/.asmltr/tool-policy.json

# Optional. Comma-separated Discord snowflakes allowed to use whole-word +xh / +h
# for one grok turn (xhigh / high). Owner/bypass is always allowed — do not put the
# owner snowflake here. No real IDs in git. Web ignores the token.
# ASMLTR_GROK_EFFORT_ELEVATE_IDS=

# Do not set XAI_API_KEY. Do not set DISCORD_BOT_TOKEN / TELEGRAM_BOT_TOKEN.
