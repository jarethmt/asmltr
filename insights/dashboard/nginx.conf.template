# Serves the SPA and proxies API/socket to the host collector.
# ${ASMLTR_INSIGHTS_TOKEN} is substituted at container start (envsubst) — the read
# bearer stays server-side. Control routes need the separate control token + an
# admins group; the read dashboard never calls them.
# ${ASMLTR_MANAGER_TOKEN} is the connector-manager bearer (write/control plane,
# host :3024) — also injected server-side so it never reaches the browser.
#
# Built-in auth (roadmap P1): browser traffic to the proxied backends is gated by an
# auth_request subrequest to the core's /v2/auth/verify (200 = valid session cookie, or
# ASMLTR_AUTH=off as break-glass; 401 = the SPA shows its login screen). The identity the
# session resolves to is forwarded as X-Remote-User (replacing Authelia's edge header).
# Connectors + the CLI talk to the core DIRECTLY (not via nginx) and are never gated here.
server {
    listen ${NGINX_LISTEN};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Bounds ONE request body. nginx's 1m default silently capped every upload: the file uploader
    # spends a third of the body on base64, so the effective ceiling was 767.9 KiB (a phone photo did
    # not fit), and /v2/backups/import was held to 1 MiB even though the core accepts 1024mb.
    #
    # Chunked uploads bound a CHUNK here, not a file, so 64m would be plenty for them. This is set to
    # 1024m because /v2/backups/import is NOT chunked: the dashboard posts the archive as one body
    # (insights/dashboard/src/services/api.js, `body: file`), so anything lower re-caps backup import
    # at exactly the value chosen here. Match the core's own limit for that route
    # (core/src/server.js, express.raw limit '1024mb') and keep this at or above the core's
    # ASMLTR_UPLOAD_MAX_CHUNK (default 64mb).
    #
    # This MUST be at server level, not inside `location /v2/`. auth_request runs the authz check as a
    # subrequest against `location = /_asmltr_authz`, which applies its OWN limit; with the directive
    # scoped to /v2/ the subrequest still inherited 1m, returned 413, and nginx turned that unexpected
    # auth status into a 500 for every chunk.
    client_max_body_size 1024m;

    # Forward-auth subrequest target (internal — only reachable from auth_request).
    location = /_asmltr_authz {
        internal;
        proxy_pass http://${ASMLTR_UPSTREAM_HOST}:3023/v2/auth/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
    }

    # Auth endpoints stay reachable WITHOUT a session (login / setup / status / verify).
    # More specific than /v2/ so it wins — and no auth_request (can't require a login to log in).
    location /v2/auth/ {
        proxy_pass http://${ASMLTR_UPSTREAM_HOST}:3023;
        proxy_set_header Host $host;
    }

    # OIDC provider (phase F) — public: RPs call discovery/jwks/token; the interaction endpoint does its
    # OWN asmltr-session check. Forward the real external proto/host so issued URLs are https + correct.
    location /oidc/ {
        proxy_pass http://${ASMLTR_UPSTREAM_HOST}:3023;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Control plane (kill/stop/send-keys) needs the STRONGER control bearer, and the
    # session-resolved user becomes the audit actor. More specific than /api/ so it wins.
    location /api/control/ {
        auth_request /_asmltr_authz;
        auth_request_set $asmltr_user $upstream_http_remote_user;
        proxy_pass http://${ASMLTR_UPSTREAM_HOST}:3017;
        proxy_set_header Authorization "Bearer ${ASMLTR_CONTROL_TOKEN}";
        proxy_set_header X-Remote-User $asmltr_user;
        proxy_set_header Host $host;
    }

    # REST: inject the read bearer; forward the session-resolved user.
    location /api/ {
        auth_request /_asmltr_authz;
        auth_request_set $asmltr_user $upstream_http_remote_user;
        proxy_pass http://${ASMLTR_UPSTREAM_HOST}:3017;
        proxy_set_header Authorization "Bearer ${ASMLTR_INSIGHTS_TOKEN}";
        proxy_set_header X-Remote-User $asmltr_user;
        proxy_set_header Host $host;
    }

    # Connector manager (control plane). The manager serves at the root, so the
    # trailing slash on proxy_pass strips the /manager/ prefix. Inject the manager bearer.
    location /manager/ {
        auth_request /_asmltr_authz;
        auth_request_set $asmltr_user $upstream_http_remote_user;
        proxy_pass http://${ASMLTR_UPSTREAM_HOST}:3024/;
        proxy_set_header Authorization "Bearer ${ASMLTR_MANAGER_TOKEN}";
        proxy_set_header X-Remote-User $asmltr_user;
        proxy_set_header Host $host;
    }

    # Trust framework (the Access control plane) on the CORE. Served at root under /trust/…
    # so NO trailing slash on proxy_pass — the /trust/ prefix is kept.
    location /trust/ {
        auth_request /_asmltr_authz;
        auth_request_set $asmltr_user $upstream_http_remote_user;
        proxy_pass http://${ASMLTR_UPSTREAM_HOST}:3023;
        proxy_set_header X-Remote-User $asmltr_user;
        proxy_set_header Host $host;
    }

    # Core control plane (/v2/inject, /v2/abort, silos, backups, vault, …). Served at root
    # on the core; keep the prefix. /v2/auth/ above is carved out (unauthenticated).
    # Upload bodies are bounded by the server-level client_max_body_size above.
    location /v2/ {
        auth_request /_asmltr_authz;
        auth_request_set $asmltr_user $upstream_http_remote_user;
        proxy_pass http://${ASMLTR_UPSTREAM_HOST}:3023;
        proxy_http_version 1.1;
        proxy_set_header X-Remote-User $asmltr_user;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 15m;
        proxy_send_timeout 15m;
    }

    # Remote-desktop signaling broker (a connector, host :3028). Fully TOKEN-gated on EVERY route
    # (view/control trust grants), and its real clients are host agents + phone viewers presenting an RD
    # token — NOT a browser session cookie — so it is deliberately NOT behind the session auth_request
    # (that would 401 the actual RD peers). The dashboard's RD view sends a device-local RD token in the
    # request body. SSE (/rd/stream) needs buffering off so signaling frames flush immediately; no prefix
    # to strip (the broker serves /rd/… at the root).
    # Injects the RD broker token into the authenticated GUI only (behind the session auth_request), so a
    # logged-in owner's Remote Desktop view lists hosts without pasting a token. Not under /rd (Traefik
    # routes /rd straight to the broker), so this stays a dashboard-served, auth-gated file.
    location = /gui-config.js {
        auth_request /_asmltr_authz;
        default_type application/javascript;
        add_header Cache-Control "no-store";
        return 200 'window.__RD_TOKEN__="${ASMLTR_RD_TOKEN}";';
    }

    location /rd/ {
        # Pinned back to nginx's own default rather than inheriting the server-level 1024m above. That
        # ceiling exists for chunk PUTs and backup import, both behind the session auth_request; this
        # location is deliberately not, so inheriting it would hand an unauthenticated route a 1 GiB
        # body budget as a side effect of an upload change. Signaling frames are SDP + ICE candidates,
        # kilobytes; 1m is the limit /rd/ already ran under before that directive existed.
        client_max_body_size 1m;

        proxy_pass http://${ASMLTR_UPSTREAM_HOST}:3028;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    # socket.io (websocket upgrade)
    location /socket.io/ {
        auth_request /_asmltr_authz;
        proxy_pass http://${ASMLTR_UPSTREAM_HOST}:3017;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Authorization "Bearer ${ASMLTR_INSIGHTS_TOKEN}";
    }

    # PWA: correct manifest MIME, and never cache the service worker (so updates propagate).
    location = /manifest.webmanifest { default_type application/manifest+json; }
    location = /sw.js { add_header Cache-Control "no-cache"; }

    # Content-hashed build assets (index-<hash>.js/.css) are immutable — cache them hard so repeat
    # loads are instant. A new deploy produces new filenames, so this never serves stale code.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # SPA history fallback (public — the app shell + login screen must always load). The shell MUST
    # revalidate every load (cheap 304 via ETag) so a new deploy's asset hashes reach clients — most
    # importantly the Android WebView, which otherwise heuristically caches index.html and gets stuck
    # on an old build even after the site updates.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
